<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>Configuration\app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\x64\Prediction\env\venv\Include\**" />
    <Compile Remove="bin\x64\Release\net8.0\trace_source\**" />
    <EmbeddedResource Remove="bin\x64\Prediction\env\venv\Include\**" />
    <EmbeddedResource Remove="bin\x64\Release\net8.0\trace_source\**" />
    <None Remove="bin\x64\Prediction\env\venv\Include\**" />
    <None Remove="bin\x64\Release\net8.0\trace_source\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.26" />
    <PackageReference Include="Microsoft.Windows.EventTracing.Processing.All" Version="1.12.10" />
    <PackageReference Include="PeNet" Version="5.1.0" />
    <PackageReference Include="SharpPcap" Version="6.3.1" />
    <PackageReference Include="System.Diagnostics.Tracing" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="bin\Debug\net8.0\" />
    <Folder Include="Configuration\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="bin\x64\Debug\net8.0\trace_result.json" />
  </ItemGroup>

</Project>
